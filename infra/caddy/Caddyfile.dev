http://localhost {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	@backendHealth path /healthz
	handle @backendHealth {
		reverse_proxy backend:8000
	}

	@media path /media/*
	handle @media {
		root * /srv
		file_server
	}

	handle {
		reverse_proxy frontend:3000
	}
}
