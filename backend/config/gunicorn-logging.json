{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "config.observability.JsonFormatter",
      "service": "backend"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["stderr"]
  },
  "loggers": {
    "gunicorn.error": {
      "level": "INFO",
      "handlers": ["stderr"],
      "propagate": false
    }
  }
}
