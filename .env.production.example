# Copy to .env.production, replace every REPLACE_ME value, then run:
# python infra/ops/validate_env.py
APP_ENV=production
RELEASE_ID=REPLACE_ME_GIT_COMMIT_OR_RELEASE_ID
SITE_ADDRESS=REPLACE_ME_REAL_HOSTNAME
ACME_EMAIL=REPLACE_ME_ACME_EMAIL
ADMIN_ALLOWED_CIDRS=REPLACE_ME_OFFICE_OR_VPN_CIDRS
DJANGO_ALLOWED_HOSTS=REPLACE_ME_REAL_HOSTNAME
DJANGO_SECRET_KEY=REPLACE_ME_64_RANDOM_CHARACTERS
PERSONAL_DATA_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_ENCRYPTION_KEY

POSTGRES_DB=mycdigitalizacion
POSTGRES_USER=mycdigitalizacion_app
POSTGRES_PASSWORD=REPLACE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

SID_MODE=disabled
SID_BASE_URL=
SID_ACCESS_TOKEN=
MERCADOPAGO_LIVE_MODE=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
CORREO_ARGENTINO_ENABLED=false
CORREO_ARGENTINO_ENVIRONMENT=production
CORREO_ARGENTINO_PRODUCTION_BASE_URL=https://api.correoargentino.com.ar/micorreo/v1
CORREO_ARGENTINO_USERNAME=
CORREO_ARGENTINO_PASSWORD=
CORREO_ARGENTINO_CUSTOMER_ID=
CORREO_ARGENTINO_ORIGIN_POSTAL_CODE=
SHIPPING_SURCHARGE_TYPE=exact
SHIPPING_SURCHARGE_VALUE=0
SHIPPING_FREE_THRESHOLD=

BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Alternative to RESTIC_PASSWORD: create infra/secrets/restic-password (chmod 600).
RESTIC_PASSWORD_FILE=
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
BACKUP_ALERT_WEBHOOK_URL=

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
POSTGRES_MEMORY=640M
REDIS_MEMORY=192M
BACKEND_MEMORY=512M
WORKER_MEMORY=512M
BEAT_MEMORY=128M
FRONTEND_MEMORY=384M
CADDY_MEMORY=128M
BACKUP_MEMORY=320M
