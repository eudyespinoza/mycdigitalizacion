# Copy this file to .env for local Docker development. Never commit real secrets.
POSTGRES_DB=mycdigitalizacion
POSTGRES_USER=mycdigitalizacion
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
APP_ENV=development
DJANGO_SECRET_KEY=unsafe-development-key-change-me
PERSONAL_DATA_ENCRYPTION_KEY=development-only-personal-data-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
NEXT_PUBLIC_API_URL=/api
SITE_ADDRESS=localhost
SID_MODE=disabled
SID_BASE_URL=
SID_ACCESS_TOKEN=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_LIVE_MODE=false
# OAuth: complete these once, then connect the seller from Administración.
MERCADOPAGO_OAUTH_CLIENT_ID=
MERCADOPAGO_OAUTH_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
CORREO_ARGENTINO_ENABLED=false
CORREO_ARGENTINO_ENVIRONMENT=qa
CORREO_ARGENTINO_QA_BASE_URL=https://apitest.correoargentino.com.ar/micorreo/v1
CORREO_ARGENTINO_PRODUCTION_BASE_URL=https://api.correoargentino.com.ar/micorreo/v1
CORREO_ARGENTINO_USERNAME=
CORREO_ARGENTINO_PASSWORD=
CORREO_ARGENTINO_CUSTOMER_ID=
CORREO_ARGENTINO_ORIGIN_POSTAL_CODE=
SHIPPING_SURCHARGE_TYPE=exact
SHIPPING_SURCHARGE_VALUE=0
SHIPPING_FREE_THRESHOLD=
